# Salin file ini menjadi .env lalu isi nilainya.
# JANGAN pernah meng-commit file .env ke repository.

# Token dari @BotFather
BOT_TOKEN=your_telegram_bot_token

# Batas ukuran file dalam byte (20971520 = 20 MB)
MAX_FILE_SIZE=20971520

# Jumlah maksimal file dalam satu operasi (Merge PDF / JPG -> PDF)
MAX_FILES=20

# Total ukuran semua file dalam satu proses, dalam byte (104857600 = 100 MB)
MAX_SESSION_SIZE=104857600

# Session timeout dalam detik (600 = 10 menit)
SESSION_TIMEOUT=600

# Level log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- Opsional (Phase 5) ---
# Isi hanya jika program tidak ditemukan otomatis.
# LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe
# TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe

# Bahasa OCR (harus terpasang di Tesseract). Contoh: ind+eng
OCR_LANGUAGES=ind+eng

# Batas waktu konversi Word -> PDF dalam detik
CONVERT_TIMEOUT=90

# --- Phase 6 ---
# Berapa proses berat (merge, OCR, konversi) boleh berjalan bersamaan.
# Yang lain menunggu antrean. Naikkan hanya jika RAM/CPU server cukup.
MAX_CONCURRENT_JOBS=2

# Batas waktu satu proses dalam detik (300 = 5 menit)
PROCESS_TIMEOUT=300

# Lokasi database & file log (relatif terhadap folder project). LOG_FILE=off untuk mematikan.
DATABASE_PATH=data/bot.db
LOG_FILE=logs/bot.log

# Riwayat operasi lebih tua dari ini (hari) dihapus otomatis
HISTORY_RETENTION_DAYS=90

# Opsional: ID Telegram admin (pisahkan koma). Admin bisa memakai /stats
# dan menerima pemberitahuan jika bot mengalami error. Cek ID Anda lewat @userinfobot.
# ADMIN_IDS=123456789
