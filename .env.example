# Salin file ini menjadi .env lalu isi nilainya:   cp .env.example .env   (Windows: copy .env.example .env)
# JANGAN pernah meng-commit file .env ke repository. Semua nilai selain BOT_TOKEN punya nilai bawaan.

# ---------- Wajib ----------
# Token dari @BotFather
BOT_TOKEN=your_telegram_bot_token

# ---------- Batas file ----------
# Ukuran maksimal per file, dalam byte (20971520 = 20 MB; batas download Telegram untuk bot juga 20 MB)
MAX_FILE_SIZE=20971520
# Jumlah file maksimal dalam satu proses (Merge PDF / JPG -> PDF)
MAX_FILES=20
# Total ukuran semua file dalam satu proses, dalam byte (104857600 = 100 MB)
MAX_SESSION_SIZE=104857600

# ---------- Sesi & proses ----------
# Sesi berakhir jika user tidak aktif selama ini, dalam detik (600 = 10 menit)
SESSION_TIMEOUT=600
# Berapa proses berat (merge, OCR, konversi) boleh berjalan bersamaan; sisanya antre
MAX_CONCURRENT_JOBS=2
# Batas waktu satu proses, dalam detik (300 = 5 menit)
PROCESS_TIMEOUT=300

# ---------- Word <-> PDF dan OCR ----------
# Isi hanya jika program tidak ditemukan otomatis
# LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe
# TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe
# Bahasa OCR (harus terpasang di Tesseract), contoh: ind+eng
OCR_LANGUAGES=ind+eng
# Batas waktu konversi Word -> PDF, dalam detik
CONVERT_TIMEOUT=90

# ---------- Penyimpanan & log ----------
# Lokasi database dan file log (relatif terhadap folder project). LOG_FILE=off mematikan file log.
DATABASE_PATH=data/bot.db
LOG_FILE=logs/bot.log
# Level log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Riwayat operasi yang lebih tua dari ini (hari) dihapus otomatis
HISTORY_RETENTION_DAYS=90

# ---------- Opsional ----------
# ID Telegram admin (pisahkan dengan koma). Admin bisa memakai /stats dan menerima pemberitahuan
# error. Cek ID Anda lewat @userinfobot.
# ADMIN_IDS=123456789
